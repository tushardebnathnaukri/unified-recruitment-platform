{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // src/lib/figma.ts and foundations/colors.stories.tsx import figma-map.json
    // and tokens.json; without this they fail typecheck. Vite resolves JSON
    // natively at runtime.
    "resolveJsonModule": true,
    "paths": {
      "@workspace/ui/*": ["./src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
