{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,

    /* Node runs this file as-is, stripping the types. That only works for
       syntax that is ERASABLE — no enums, no parameter properties — and it
       needs the `.ts` on every relative import. */
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"]
}
