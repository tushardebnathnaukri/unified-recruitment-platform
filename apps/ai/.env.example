# Copy to .env.local (gitignored) and fill in. Read by `npm run dev` / `npm start`
# in this folder through Node's --env-file-if-exists; never sent to the browser.

GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Optional. minimal | low | medium | high. Defaults to minimal — reading an
# answer is not reasoning, and the model's default made each turn take ~6s.
# GEMINI_THINKING=minimal

# Faster (~2.2s a turn) and a little less careful:
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Defaults to 8787 — the port apps/web's Vite proxy forwards /api to.
# PORT=8787

# Deployed only: the web app's origin(s), comma-separated. Unset allows localhost.
# ALLOWED_ORIGINS=https://your-preview.example.com
